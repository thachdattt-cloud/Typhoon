@page "/manager/employees"
@using System.Linq
@using System.Text.RegularExpressions
@inject QuanLyKhachSan_fix.Services.Interfaces.Manager.IEmployeeService EmployeeService
@inject CurrentUserState UserState
@inject NavigationManager NavigationManager
<AuthorizeRole Roles="manager">
<h3>Quản lý nhân viên</h3>

<div class="card p-3 mb-3">
    <h5>Thêm nhân viên mới</h5>
    <div class="row g-2">
        <div class="col-md-2"><input class="form-control" placeholder="Username" @bind="formUsername" /></div>
        <div class="col-md-2"><input class="form-control" type="password" placeholder="Mật khẩu" @bind="formPassword" /></div>
        <div class="col-md-2"><input class="form-control" placeholder="Họ tên" @bind="formFullName" /></div>
        <div class="col-md-2"><input class="form-control" type="email" placeholder="ten@vidu.com" @bind="formEmail" /></div>
        <div class="col-md-2">
            <input class="form-control" type="tel" inputmode="numeric" maxlength="11" placeholder="SĐT"
                   value="@formPhone" @oninput="HandlePhoneInput" />
        </div>
        <div class="col-md-2">
            <select class="form-control" @bind="formPosition">
                <option value="receptionist">Lễ tân</option>
                <option value="manager">Quản lý</option>
            </select>
        </div>
        <div class="col-md-2"><input class="form-control" type="number" placeholder="Lương" @bind="formSalary" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100" @onclick="HandleCreateClick">Tạo tài khoản</button></div>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger mt-2">@errorMessage</p>
    }
</div>

@if (loading)
{
    <p>Đang tải...</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr><th>Họ tên</th><th>Username</th><th>Chức vụ</th><th>Lương</th><th>Trạng thái</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var emp in employees)
            {
                <tr>
                    <td>@emp.User.FullName</td>
                    <td>@emp.User.Username</td>
                    <td>@emp.Position</td>
                    <td>@emp.Salary?.ToString("N0")</td>
                    <td>@(emp.User.IsActive ? "Đang làm" : "Đã khóa")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleDeactivateClick(emp.Id)">Khóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</AuthorizeRole>
@code {

    private bool loading = true;
    private List<Employee> employees = new();

    private string formUsername = "";
    private string formPassword = "";
    private string formFullName = "";
    private string formEmail = "";
    private string formPhone = "";
    private string formPosition = "receptionist";
    private decimal? formSalary;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        if (!AccessGuard.Ensure(UserState, NavigationManager, "manager"))
            return;
        await LoadEmployeesAsync();
    }
    private static readonly Regex EmailRegex = new(@"^[^\s@]+@[^\s@]+\.[^\s@]+$", RegexOptions.Compiled);

    private void HandlePhoneInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        formPhone = new string(raw.Where(char.IsDigit).ToArray());
    }

    private async Task LoadEmployeesAsync()
    {
        loading = true;
        employees = await EmployeeService.GetAllEmployeesAsync();
        loading = false;
    }

    private async Task HandleCreateClick()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(formUsername) || string.IsNullOrWhiteSpace(formPassword))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.";
            return;
        }
        if (string.IsNullOrWhiteSpace(formEmail))
        {
            errorMessage = "Vui lòng nhập email.";
            return;
        }
        if (!EmailRegex.IsMatch(formEmail))
        {
            errorMessage = "Email không đúng định dạng (ví dụ: ten@vidu.com).";
            return;
        }
        if (string.IsNullOrWhiteSpace(formPhone))
        {
            errorMessage = "Vui lòng nhập số điện thoại.";
            return;
        }
        if (formPhone.Length < 9 || formPhone.Length > 11)
        {
            errorMessage = "Số điện thoại phải có từ 9 đến 11 chữ số.";
            return;
        }

        var result = await EmployeeService.CreateEmployeeAsync(
           formUsername, formPassword, formFullName, formEmail, formPhone, formPosition, formSalary);
        errorMessage = "";
       
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage;
            return;
        }

        formUsername = formPassword = formFullName = formEmail = formPhone = "";
        formSalary = null;
        await LoadEmployeesAsync();
    }

    private async Task HandleDeactivateClick(int employeeId)
    {
        await EmployeeService.DeactivateEmployeeAsync(employeeId);
        await LoadEmployeesAsync();
    }
}