@page "/receptionist/invoice"
@using System.Linq
@inject QuanLyKhachSan_fix.Services.Interfaces.Receptionist.IInvoiceService InvoiceService
@inject QuanLyKhachSan_fix.Services.Interfaces.Customer.IPaymentService PaymentService
@inject QuanLyKhachSan_fix.Services.CurrentUserState CurrentUserState
@using InvoiceModel = QuanLyKhachSan_fix.Models.Invoice

<h3>Xuất hóa đơn</h3>

<div class="card p-3 mb-3">
    <p class="text-muted mb-0">Nhân viên thực hiện: @(CurrentUserState.CurrentUser?.FullName ?? "Chưa đăng nhập")</p>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger mt-2 mb-0">@errorMessage</p>
    }
</div>

@if (pendingBookingId != null)
{
    <div class="card p-3 mb-3 border-warning">
        <h5 class="mb-2">Xác nhận thanh toán còn thiếu - @pendingBookingCode</h5>
        @if (pendingPayments.Count == 0)
        {
            <p class="text-muted mb-0">Không có phiếu thanh toán "pending" nào cho đặt phòng này.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Ngày gửi</th>
                        <th>Số tiền</th>
                        <th>Hình thức</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pendingPayments)
                    {
                        <tr>
                            <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@p.Amount.ToString("N0") đ</td>
                            <td>@(p.PaymentMethod == "online" ? "Online" : "Tiền mặt")</td>
                            <td>
                                <button class="btn btn-sm btn-success" @onclick="() => HandleConfirmPaymentClick(p.Id)">Xác nhận đã thu</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <button class="btn btn-sm btn-outline-secondary" style="width: fit-content;" @onclick="HandleClosePendingPanel">Đóng</button>
    </div>
}

@if (previewBookingId != null && preview != null)
{
    <div class="card p-3 mb-3 border-primary">
        <h5 class="mb-3">Xem trước hóa đơn phụ phí - @preview.BookingCode</h5>

        <h6>Thông tin khách hàng</h6>
        <p class="mb-1">Họ tên: <strong>@(preview.CustomerFullName ?? "-")</strong></p>
        <p class="mb-1">Tài khoản: @(preview.CustomerUsername ?? "-")</p>
        <p class="mb-1">Điện thoại: @(preview.CustomerPhone ?? "-")</p>
        <p class="mb-3">Email: @(preview.CustomerEmail ?? "-")</p>

        <h6>Thời gian lưu trú</h6>
        <p class="mb-3">
            Từ <strong>@preview.CheckInDate.ToString("dd/MM/yyyy")</strong>
            đến <strong>@preview.CheckOutDate.ToString("dd/MM/yyyy")</strong>
            (<strong>@preview.Nights đêm</strong>)
        </p>

        <h6>Phòng đã ở</h6>
        <table class="table table-sm mb-3">
            <thead>
                <tr>
                    <th>Phòng</th>
                    <th>Loại phòng</th>
                    <th>Số khách</th>
                    <th>Giá</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in preview.Rooms)
                {
                    <tr>
                        <td>@room.RoomNumber</td>
                        <td>@room.RoomTypeName</td>
                        <td>@(room.GuestCount?.ToString() ?? "-")</td>
                        <td>@room.Price.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <h6>Chi tiết yêu cầu</h6>
        <table class="table table-sm mb-3">
            <thead>
                <tr>
                    <th>Yêu cầu</th>
                    <th>Ngày</th>
                    <th>Số tiền</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Yêu cầu đặt phòng ban đầu (đã xuất hóa đơn lúc nhận phòng)</td>
                    <td>@preview.CheckInDate.ToString("dd/MM/yyyy")</td>
                    <td>@preview.OriginalAmount.ToString("N0") đ</td>
                </tr>
                @foreach (var s in preview.ExtraServices)
                {
                    <tr>
                        <td>@s.Description</td>
                        <td>@(s.HandledAt?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@s.ExtraFee.ToString("N0") đ (phụ phí)</td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="mb-3">Tổng phụ phí sẽ xuất hóa đơn: <strong>@preview.ExtraFeeAmount.ToString("N0") đ</strong></p>

        <div class="row g-2">
            <div class="col-md-4">
                <button class="btn btn-success w-100" @onclick="() => HandleCreateInvoiceClick(preview.BookingId, preview.BookingCode)">Xác nhận xuất hóa đơn</button>
            </div>
            <div class="col-md-4">
                <button class="btn btn-outline-secondary w-100" @onclick="HandleClosePreviewPanel">Hủy</button>
            </div>
        </div>
    </div>
}

<h5>Đơn có phụ phí phát sinh, chờ xuất hóa đơn bổ sung</h5>
<p class="text-muted">Tiền phòng đã được xuất hóa đơn ngay lúc nhận phòng — mục này chỉ dành cho phụ phí (gia hạn/đổi phòng phát sinh trong kỳ lưu trú).</p>
@if (loading)
{
    <p>Đang tải...</p>
}
else if (!pendingBookings.Any())
{
    <p>Không có đơn nào chờ xuất hóa đơn phụ phí.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã đặt phòng</th>
                <th>Khách hàng</th>
                <th>Số phòng đã ở</th>
                <th>Trạng thái đơn</th>
                <th>Phụ phí</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in pendingBookings)
            {
                <tr>
                    <td>@booking.BookingCode</td>
                    <td>@booking.Customer.FullName</td>
                    <td>@booking.BookingDetails.Count</td>
                    <td><span class="badge bg-secondary">Đã trả phòng</span></td>
                    <td>@pendingExtraFees[booking.Id].ToString("N0") đ</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => HandleOpenPreviewClick(booking.Id)">Xem trước</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h5 class="mt-4">Hóa đơn đã xuất</h5>
@if (!invoices.Any())
{
    <p>Chưa có hóa đơn nào.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã hóa đơn</th>
                <th>Mã đặt phòng</th>
                <th>Khách hàng</th>
                <th>Loại hóa đơn</th>
                <th>Tổng tiền</th>
                <th>Đã trả / Còn thiếu (tiền phòng)</th>
                <th>Ngày xuất</th>
                <th>Người xuất</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in invoices)
            {
                <tr>
                    <td>@inv.Id</td>
                    <td>@inv.Booking.BookingCode</td>
                    <td>@inv.Booking.Customer.FullName</td>
                    <td>
                        @if (checkInInvoiceIds.Contains(inv.Id))
                        {
                            <span class="badge bg-primary">Nhận phòng (tiền phòng)</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">Trả phòng (phụ phí)</span>
                        }
                    </td>
                    <td>@inv.TotalAmount?.ToString("N0") đ</td>
                    <td>
                        @if (checkInInvoiceIds.Contains(inv.Id) && paidVsOwing.TryGetValue(inv.Id, out var breakdown))
                        {
                            <span>Đã trả: @breakdown.Paid.ToString("N0") đ</span><br />
                            @if (breakdown.Owing > 0)
                            {
                                <span class="text-danger">Còn thiếu: @breakdown.Owing.ToString("N0") đ</span>
                            }
                            else
                            {
                                <span class="text-success">Đã trả đủ</span>
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@inv.IssuedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@inv.IssuedByUser?.FullName</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool loading = true;
    private List<Booking> pendingBookings = new();
    private Dictionary<int, decimal> pendingExtraFees = new();
    private List<InvoiceModel> invoices = new();
    private HashSet<int> checkInInvoiceIds = new();
    private Dictionary<int, (decimal Paid, decimal Owing)> paidVsOwing = new();
    private string errorMessage = "";

    private int? pendingBookingId;
    private string pendingBookingCode = "";
    private List<QuanLyKhachSan_fix.Models.Payment> pendingPayments = new();

    private int? previewBookingId;
    private QuanLyKhachSan_fix.Services.Interfaces.Receptionist.InvoicePreview? preview;

    private async Task HandleOpenPreviewClick(int bookingId)
    {
        errorMessage = "";
        preview = await InvoiceService.GetInvoicePreviewAsync(bookingId);
        previewBookingId = bookingId;
    }

    private void HandleClosePreviewPanel()
    {
        previewBookingId = null;
        preview = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        pendingBookings = await InvoiceService.GetBookingsReadyForInvoiceAsync();
        invoices = await InvoiceService.GetAllInvoicesAsync();

        pendingExtraFees = new Dictionary<int, decimal>();
        foreach (var booking in pendingBookings)
        {
            pendingExtraFees[booking.Id] = await InvoiceService.CalculateExtraFeeAsync(booking.Id);
        }

        // Hoa don DAU TIEN (theo IssuedAt) cua moi booking la hoa don nhan phong (tien phong).
        checkInInvoiceIds = invoices
            .GroupBy(i => i.BookingId)
            .Select(g => g.OrderBy(i => i.IssuedAt).First().Id)
            .ToHashSet();

        paidVsOwing = new Dictionary<int, (decimal, decimal)>();
        foreach (var inv in invoices.Where(i => checkInInvoiceIds.Contains(i.Id)))
        {
            decimal roomAmount = inv.TotalAmount ?? 0;
            decimal totalPaid = await PaymentService.GetPaidAmountAsync(inv.BookingId);
            decimal paidTowardRoom = Math.Min(totalPaid, roomAmount);
            decimal owing = roomAmount - paidTowardRoom;
            paidVsOwing[inv.Id] = (paidTowardRoom, owing < 0 ? 0 : owing);
        }

        loading = false;
    }

    private async Task HandleCreateInvoiceClick(int bookingId, string? bookingCode)
    {
        errorMessage = "";
        var staffId = CurrentUserState.CurrentUser?.Id;
        if (staffId == null || staffId <= 0)
        {
            errorMessage = "Bạn cần đăng nhập trước khi thực hiện thao tác này.";
            return;
        }

        var result = await InvoiceService.CreateInvoiceAsync(bookingId, staffId.Value);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? "";

            if (errorMessage.Contains("còn nợ"))
            {
                pendingBookingId = bookingId;
                pendingBookingCode = bookingCode ?? $"#{bookingId}";
                var allPayments = await PaymentService.GetPaymentsByBookingAsync(bookingId);
                pendingPayments = allPayments.Where(p => p.PaymentStatus == "pending").ToList();
            }

            return;
        }

        pendingBookingId = null;
        previewBookingId = null;
        preview = null;
        await LoadDataAsync();
    }

    private async Task HandleConfirmPaymentClick(int paymentId)
    {
        var staffId = CurrentUserState.CurrentUser?.Id;
        if (staffId == null || staffId <= 0)
        {
            errorMessage = "Bạn cần đăng nhập trước khi thực hiện thao tác này.";
            return;
        }

        var result = await PaymentService.ConfirmCashPaymentAsync(paymentId, staffId.Value);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? "";
            return;
        }

        if (pendingBookingId.HasValue)
        {
            var allPayments = await PaymentService.GetPaymentsByBookingAsync(pendingBookingId.Value);
            pendingPayments = allPayments.Where(p => p.PaymentStatus == "pending").ToList();
        }

        errorMessage = "Đã xác nhận thanh toán. Bấm \"Xuất hóa đơn\" lại để tiếp tục.";
    }

    private void HandleClosePendingPanel()
    {
        pendingBookingId = null;
        pendingPayments = new();
    }
}
