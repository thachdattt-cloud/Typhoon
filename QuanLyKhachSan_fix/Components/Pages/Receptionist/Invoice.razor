@page "/receptionist/invoice"
@inject IInvoiceService InvoiceService
@inject QuanLyKhachSan_fix.Services.CurrentUserState CurrentUserState
@using InvoiceModel = QuanLyKhachSan_fix.Models.Invoice

<h3>Xuất hóa đơn</h3>

<div class="card p-3 mb-3">
    <p class="text-muted mb-0">Nhân viên thực hiện: @(CurrentUserState.CurrentUser?.FullName ?? "Chưa đăng nhập")</p>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger mt-2 mb-0">@errorMessage</p>
    }
</div>

<h5>Đơn đã trả phòng, chờ xuất hóa đơn</h5>
@if (loading)
{
    <p>Đang tải...</p>
}
else if (!pendingBookings.Any())
{
    <p>Không có đơn nào chờ xuất hóa đơn.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã đặt phòng</th>
                <th>Khách hàng</th>
                <th>Số phòng đã ở</th>
                <th>Tổng tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in pendingBookings)
            {
                <tr>
                    <td>@booking.BookingCode</td>
                    <td>@booking.Customer.FullName</td>
                    <td>@booking.BookingDetails.Count</td>
                    <td>@pendingTotals[booking.Id].ToString("N0") đ</td>
                    <td>
                        <button class="btn btn-sm btn-success" @onclick="() => HandleCreateInvoiceClick(booking.Id)">Xuất hóa đơn</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h5 class="mt-4">Hóa đơn đã xuất</h5>
@if (!invoices.Any())
{
    <p>Chưa có hóa đơn nào.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã hóa đơn</th>
                <th>Mã đặt phòng</th>
                <th>Khách hàng</th>
                <th>Tổng tiền</th>
                <th>Ngày xuất</th>
                <th>Người xuất</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in invoices)
            {
                <tr>
                    <td>@inv.Id</td>
                    <td>@inv.Booking.BookingCode</td>
                    <td>@inv.Booking.Customer.FullName</td>
                    <td>@inv.TotalAmount?.ToString("N0") đ</td>
                    <td>@inv.IssuedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@inv.IssuedByUser?.FullName</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool loading = true;
    private List<Booking> pendingBookings = new();
    private Dictionary<int, decimal> pendingTotals = new();
    private List<InvoiceModel> invoices = new();
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        pendingBookings = await InvoiceService.GetBookingsReadyForInvoiceAsync();
        invoices = await InvoiceService.GetAllInvoicesAsync();

        pendingTotals = new Dictionary<int, decimal>();
        foreach (var booking in pendingBookings)
        {
            pendingTotals[booking.Id] = await InvoiceService.CalculateTotalAmountAsync(booking.Id);
        }

        loading = false;
    }

    private async Task HandleCreateInvoiceClick(int bookingId)
    {
        errorMessage = "";
        var staffId = CurrentUserState.CurrentUser?.Id;
        if (staffId == null || staffId <= 0)
        {
            errorMessage = "Bạn cần đăng nhập trước khi thực hiện thao tác này.";
            return;
        }

        var result = await InvoiceService.CreateInvoiceAsync(bookingId, staffId.Value);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? "";
            return;
        }

        await LoadDataAsync();
    }
}
