@page "/receptionist/check-out"
@using System.Linq
@inject QuanLyKhachSan_fix.Services.Interfaces.Receptionist.ICheckInOutService CheckInOutService
@inject QuanLyKhachSan_fix.Services.Interfaces.Customer.IPaymentService PaymentService
@inject QuanLyKhachSan_fix.Services.Interfaces.Receptionist.IInvoiceService InvoiceService
@inject QuanLyKhachSan_fix.Services.CurrentUserState CurrentUserState

<h3>Trả phòng</h3>
<p class="text-muted">Chỉ hiển thị các phòng đang ở trạng thái <strong>Nhận phòng (checked_in)</strong>.</p>

<div class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Mã đặt phòng</label>
            <input class="form-control" placeholder="VD: BK0001" @bind="searchBookingCode" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100" @onclick="HandleSearchClick">Tìm</button>
        </div>
        <div class="col-md-4">
            <button class="btn btn-outline-secondary w-100" @onclick="HandleShowAllClick">Tất cả phòng có thể trả</button>
        </div>
    </div>
    <p class="text-muted mt-2 mb-0">Nhân viên thực hiện: @(CurrentUserState.CurrentUser?.FullName ?? "Chưa đăng nhập")</p>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger mt-2">@errorMessage</p>
    }
    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <p class="text-success mt-2">@infoMessage</p>
    }
</div>

@if (confirmingBookingDetailId != null && confirmingPreview != null)
{
    <div class="card p-3 mb-3 border-warning">
        <h5 class="mb-2">Trả phòng - @confirmingPreview.BookingCode</h5>
        <p class="mb-1">Khách hàng: <strong>@(confirmingPreview.CustomerFullName ?? "-")</strong></p>
        <p class="mb-1">
            Phòng: @string.Join(", ", confirmingPreview.Rooms.Select(r => r.RoomNumber))
            &nbsp;|&nbsp; @confirmingPreview.CheckInDate.ToString("dd/MM/yyyy") → @confirmingPreview.CheckOutDate.ToString("dd/MM/yyyy")
            (@confirmingPreview.Nights đêm)
        </p>
        <p class="mb-1">Tổng tiền: <strong>@confirmingPreview.TotalAmount.ToString("N0") đ</strong></p>
        <p class="mb-2">Đã thanh toán: <strong>@confirmingPreview.PaidAmount.ToString("N0") đ</strong></p>

        @if (confirmingPreview.OutstandingAmount > 0)
        {
            <p class="mb-2 text-danger">Còn thiếu: <strong>@confirmingPreview.OutstandingAmount.ToString("N0") đ</strong></p>

            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-4">
                    <label class="form-label">Số tiền thu</label>
                    <input class="form-control" type="number" min="0" step="1000" @bind="confirmingPayAmount" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Hình thức</label>
                    <select class="form-select" @bind="confirmingPayMethod">
                        <option value="cash">Tiền mặt</option>
                        <option value="online">Online (đã thu qua cổng)</option>
                    </select>
                </div>
            </div>
        }
        else
        {
            <p class="mb-2 text-success">Đã thanh toán đủ - có thể trả phòng ngay.</p>
        }

        <div class="row g-2">
            <div class="col-md-4">
                <button class="btn btn-warning w-100" @onclick="HandleConfirmCheckOutClick">Xác nhận trả phòng</button>
            </div>
            <div class="col-md-4">
                <button class="btn btn-outline-secondary w-100" @onclick="HandleCancelConfirmPanel">Hủy</button>
            </div>
        </div>
    </div>
}

@if (loading)
{
    <p>Đang tải...</p>
}
else if (!bookingDetails.Any())
{
    <p>Không có phòng nào đang chờ trả phòng.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã đặt phòng</th>
                <th>Khách hàng</th>
                <th>Phòng</th>
                <th>Loại phòng</th>
                <th>Nhận phòng</th>
                <th>Trả phòng</th>
                <th>Trạng thái đơn</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bd in bookingDetails)
            {
                <tr>
                    <td>@bd.Booking.BookingCode</td>
                    <td>@bd.Booking.Customer.FullName</td>
                    <td>@bd.Room.RoomNumber</td>
                    <td>@bd.Room.RoomType.Name</td>
                    <td>@bd.Booking.CheckInDate.ToString("dd/MM/yyyy")</td>
                    <td>@bd.Booking.CheckOutDate.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge bg-info text-dark">Đang lưu trú</span></td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => HandleStartCheckOutClick(bd)">Trả phòng</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool loading = true;
    private List<QuanLyKhachSan_fix.Models.BookingDetail> bookingDetails = new();
    private string searchBookingCode = "";
    private string errorMessage = "";
    private string infoMessage = "";

    private int? confirmingBookingDetailId;
    private QuanLyKhachSan_fix.Services.Interfaces.Receptionist.InvoicePreview? confirmingPreview;
    private decimal confirmingPayAmount;
    private string confirmingPayMethod = "cash";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllCheckedInAsync();
    }

    private async Task LoadAllCheckedInAsync()
    {
        loading = true;
        bookingDetails = await CheckInOutService.GetAllCheckedInAsync();
        loading = false;
    }

    private async Task HandleShowAllClick()
    {
        searchBookingCode = "";
        await LoadAllCheckedInAsync();
    }

    private async Task HandleSearchClick()
    {
        loading = true;
        errorMessage = "";
        bookingDetails = string.IsNullOrWhiteSpace(searchBookingCode)
            ? await CheckInOutService.GetAllCheckedInAsync()
            : await CheckInOutService.SearchCheckedInByBookingCodeAsync(searchBookingCode);
        loading = false;
    }

    private async Task HandleStartCheckOutClick(QuanLyKhachSan_fix.Models.BookingDetail bd)
    {
        errorMessage = "";
        infoMessage = "";

        confirmingPreview = await InvoiceService.GetInvoicePreviewAsync(bd.Booking.Id);
        confirmingPayAmount = confirmingPreview.OutstandingAmount;
        confirmingPayMethod = "cash";
        confirmingBookingDetailId = bd.Id;
    }

    private void HandleCancelConfirmPanel()
    {
        confirmingBookingDetailId = null;
        confirmingPreview = null;
    }

    private async Task HandleConfirmCheckOutClick()
    {
        if (confirmingBookingDetailId == null || confirmingPreview == null) return;

        errorMessage = "";
        var staffId = CurrentUserState.CurrentUser?.Id;
        if (staffId == null || staffId <= 0)
        {
            errorMessage = "Bạn cần đăng nhập trước khi thực hiện thao tác này.";
            return;
        }

        if (confirmingPreview.OutstandingAmount > 0)
        {
            if (confirmingPayAmount < confirmingPreview.OutstandingAmount)
            {
                errorMessage = $"Số tiền thu chưa đủ khoản còn thiếu ({confirmingPreview.OutstandingAmount.ToString("N0")} đ).";
                return;
            }

            var paymentResult = await PaymentService.CreateStaffCollectedPaymentAsync(confirmingPreview.BookingId, confirmingPayAmount, confirmingPayMethod, staffId.Value);
            if (!paymentResult.Success)
            {
                errorMessage = paymentResult.ErrorMessage ?? "";
                return;
            }
        }

        var checkOutResult = await CheckInOutService.CheckOutAsync(confirmingBookingDetailId.Value, staffId.Value);
        if (!checkOutResult.Success)
        {
            errorMessage = checkOutResult.ErrorMessage ?? "";
            return;
        }

        infoMessage = $"Đã trả phòng cho {confirmingPreview.BookingCode}.";
        confirmingBookingDetailId = null;
        confirmingPreview = null;
        await HandleSearchClick();
    }
}
