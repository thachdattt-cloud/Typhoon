@page "/receptionist/check-out"
@using System.Linq
@inject QuanLyKhachSan_fix.Services.Interfaces.Receptionist.ICheckInOutService CheckInOutService
@inject QuanLyKhachSan_fix.Services.Interfaces.Customer.IPaymentService PaymentService
@inject QuanLyKhachSan_fix.Services.CurrentUserState CurrentUserState

<h3>Trả phòng</h3>

<div class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Mã đặt phòng</label>
            <input class="form-control" placeholder="VD: BK0001" @bind="searchBookingCode" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100" @onclick="HandleSearchClick">Tìm</button>
        </div>
        <div class="col-md-4">
            <button class="btn btn-outline-secondary w-100" @onclick="HandleShowAllClick">Tất cả phòng có thể trả</button>
        </div>
    </div>
    <p class="text-muted mt-2 mb-0">Nhân viên thực hiện: @(CurrentUserState.CurrentUser?.FullName ?? "Chưa đăng nhập")</p>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger mt-2">@errorMessage</p>
    }
</div>

@if (pendingBookingId != null)
{
    <div class="card p-3 mb-3 border-warning">
        <h5 class="mb-2">Xác nhận thanh toán còn thiếu - @pendingBookingCode</h5>
        @if (pendingPayments.Count == 0)
        {
            <p class="text-muted mb-0">Không có phiếu thanh toán "pending" nào cho đặt phòng này. Kiểm tra lại số tiền còn nợ (có thể khách chưa gửi yêu cầu thanh toán nào).</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Ngày gửi</th>
                        <th>Số tiền</th>
                        <th>Hình thức</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pendingPayments)
                    {
                        <tr>
                            <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@p.Amount.ToString("N0") đ</td>
                            <td>@(p.PaymentMethod == "online" ? "Online" : "Tiền mặt")</td>
                            <td>
                                <button class="btn btn-sm btn-success" @onclick="() => HandleConfirmPaymentClick(p.Id)">Xác nhận đã thu</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <button class="btn btn-sm btn-outline-secondary" style="width: fit-content;" @onclick="HandleClosePendingPanel">Đóng</button>
    </div>
}

@if (loading)
{
    <p>Đang tải...</p>
}
else if (!bookingDetails.Any())
{
    <p>Không có phòng nào đang chờ trả phòng.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã đặt phòng</th>
                <th>Khách hàng</th>
                <th>Phòng</th>
                <th>Loại phòng</th>
                <th>Nhận phòng</th>
                <th>Trả phòng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bd in bookingDetails)
            {
                <tr>
                    <td>@bd.Booking.BookingCode</td>
                    <td>@bd.Booking.Customer.FullName</td>
                    <td>@bd.Room.RoomNumber</td>
                    <td>@bd.Room.RoomType.Name</td>
                    <td>@bd.Booking.CheckInDate.ToString("dd/MM/yyyy")</td>
                    <td>@bd.Booking.CheckOutDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => HandleCheckOutClick(bd.Id, bd.Booking.Id, bd.Booking.BookingCode)">Trả phòng</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool loading = true;
    private List<QuanLyKhachSan_fix.Models.BookingDetail> bookingDetails = new();
    private string searchBookingCode = "";
    private string errorMessage = "";

    private int? pendingBookingId;
    private string pendingBookingCode = "";
    private List<QuanLyKhachSan_fix.Models.Payment> pendingPayments = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllCheckedInAsync();
    }

    private async Task LoadAllCheckedInAsync()
    {
        loading = true;
        bookingDetails = await CheckInOutService.GetAllCheckedInAsync();
        loading = false;
    }

    private async Task HandleShowAllClick()
    {
        searchBookingCode = "";
        await LoadAllCheckedInAsync();
    }

    private async Task HandleSearchClick()
    {
        loading = true;
        errorMessage = "";
        bookingDetails = string.IsNullOrWhiteSpace(searchBookingCode)
            ? await CheckInOutService.GetAllCheckedInAsync()
            : await CheckInOutService.SearchCheckedInByBookingCodeAsync(searchBookingCode);
        loading = false;
    }

    private async Task HandleCheckOutClick(int bookingDetailId, int bookingId, string? bookingCode)
    {
        errorMessage = "";
        var staffId = CurrentUserState.CurrentUser?.Id;
        if (staffId == null || staffId <= 0)
        {
            errorMessage = "Bạn cần đăng nhập trước khi thực hiện thao tác này.";
            return;
        }

        var result = await CheckInOutService.CheckOutAsync(bookingDetailId, staffId.Value);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? "";

            // Neu ly do khong tra phong duoc la vi con no tien, mo bang danh sach
            // payment "pending" de le tan xac nhan da thu tien ngay tai day.
            if (errorMessage.Contains("còn nợ"))
            {
                pendingBookingId = bookingId;
                pendingBookingCode = bookingCode ?? $"#{bookingId}";
                var allPayments = await PaymentService.GetPaymentsByBookingAsync(bookingId);
                pendingPayments = allPayments.Where(p => p.PaymentStatus == "pending").ToList();
            }

            return;
        }

        pendingBookingId = null;
        await HandleSearchClick();
    }

    private async Task HandleConfirmPaymentClick(int paymentId)
    {
        var staffId = CurrentUserState.CurrentUser?.Id;
        if (staffId == null || staffId <= 0)
        {
            errorMessage = "Bạn cần đăng nhập trước khi thực hiện thao tác này.";
            return;
        }

        var result = await PaymentService.ConfirmCashPaymentAsync(paymentId, staffId.Value);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? "";
            return;
        }

        // Sau khi xac nhan, lam moi lai danh sach pending cho booking dang xet
        if (pendingBookingId.HasValue)
        {
            var allPayments = await PaymentService.GetPaymentsByBookingAsync(pendingBookingId.Value);
            pendingPayments = allPayments.Where(p => p.PaymentStatus == "pending").ToList();
        }

        errorMessage = "Đã xác nhận thanh toán. Bấm \"Trả phòng\" lại để tiếp tục.";
    }

    private void HandleClosePendingPanel()
    {
        pendingBookingId = null;
        pendingPayments = new();
    }
}
