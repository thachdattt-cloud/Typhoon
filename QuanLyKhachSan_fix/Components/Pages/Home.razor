@page "/"
@using QuanLyKhachSan_fix.Services
@inject CurrentUserState UserState
@inject NavigationManager NavigationManager

<div class="home-page">
    <div class="home-nav">
        <div class="home-logo">GOLDEN HOTEL</div>
        <div class="home-nav-links">
            <a href="/customer/room-search">Tìm phòng</a>
            <a href="/customer/my-bookings">Đặt phòng của tôi</a>
        </div>
        <div class="home-nav-actions">
            @if (UserState.CurrentUser == null)
            {
                <a class="btn btn-outline-dark" href="/login">Đăng nhập</a>
                <a class="btn btn-dark home-btn-become" href="/register">Đăng ký</a>
            }
            else
            {
                <span class="home-welcome">Xin chào, @(UserState.CurrentUser.FullName ?? UserState.CurrentUser.Username)</span>
            }
        </div>
    </div>

    <div class="home-hero">
        <div class="home-find-row">
            <span class="home-find-title">TÌM</span>
            @foreach (var type in roomTypeTabs)
            {
                <span class="home-find-tab @(type == selectedType ? "active" : "")" @onclick="() => SelectType(type)">@type</span>
            }
        </div>

        <div class="home-search-box">
            <div class="home-search-field">
                <label>Nhận phòng</label>
                <input type="date" @bind="checkInDate" />
            </div>
            <div class="home-search-field">
                <label>Trả phòng</label>
                <input type="date" @bind="checkOutDate" />
            </div>
            <div class="home-search-field">
                <label>Số khách</label>
                <input type="number" min="1" max="20" @bind="guestCount" />
            </div>
            <button class="home-search-btn" @onclick="HandleSearchClick" aria-label="Tìm phòng">
                🔍
            </button>
        </div>
    </div>
</div>

@code {
    private readonly string[] roomTypeTabs = new[] { "Standard", "Superior", "Deluxe", "Family", "Suite" };
    private string selectedType = "Standard";

    private DateTime checkInDate = DateTime.Today;
    private DateTime checkOutDate = DateTime.Today.AddDays(1);
    private int guestCount = 1;

    private void SelectType(string type)
    {
        selectedType = type;
    }

    private void HandleSearchClick()
    {
        string checkIn = checkInDate.ToString("yyyy-MM-dd");
        string checkOut = checkOutDate.ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/customer/room-search?checkIn={checkIn}&checkOut={checkOut}&guestCount={guestCount}");
    }
}
