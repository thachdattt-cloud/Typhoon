@inject CurrentUserState CurrentUserState
@inject NavigationManager NavManager
@implements IDisposable
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">QuanLyKhachSan_fix</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    @if (CurrentUserState.IsLoggedIn)
    {
        <div class="nav-item px-3 py-2">
            <span class="text-white">Xin chào, @CurrentUserState.CurrentUser!.FullName</span>
        </div>
        <div class="nav-item px-3">
            <button class="nav-link btn btn-link text-start p-0" @onclick="HandleLogoutClick">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Đăng xuất
            </button>
        </div>
    }
    @if (CurrentUserState.CurrentUser?.Role == "manager")
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="manager/dashboard">
                <span class="bi bi-speedometer2" aria-hidden="true"></span> Quản lý - Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="manager/room-types">
                <span class="bi bi-house-door" aria-hidden="true"></span> Loại phòng & giá
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="manager/employees">
                <span class="bi bi-people" aria-hidden="true"></span> Quản lý nhân viên
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="manager/customers">
                <span class="bi bi-person-check" aria-hidden="true"></span> Tài khoản khách hàng
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="manager/revenue-report">
                <span class="bi bi-graph-up" aria-hidden="true"></span> Báo cáo doanh thu
            </NavLink>
        </div>
    }
    @if (CurrentUserState.CurrentUser?.Role == "customer")
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="customer/dashboard">
                <span class="bi bi-speedometer2" aria-hidden="true"></span> Khách hàng - Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="customer/book-room">
                <span class="bi bi-calendar-check" aria-hidden="true"></span> Đặt phòng
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="customer/my-bookings">
                <span class="bi bi-card-list" aria-hidden="true"></span> Lịch sử đặt phòng
            </NavLink>
        </div>
    }
    @if (CurrentUserState.CurrentUser?.Role == "receptionist")
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="receptionist/dashboard">
                <span class="bi bi-speedometer2" aria-hidden="true"></span> Lễ tân - Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="receptionist/check-in">
                <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Nhận phòng
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="receptionist/check-out">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Trả phòng
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="receptionist/approve-request">
                <span class="bi bi-check2-square" aria-hidden="true"></span> Duyệt yêu cầu
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="receptionist/invoice">
                <span class="bi bi-receipt" aria-hidden="true"></span> Xuất hóa đơn
            </NavLink>
        </div>
    }
    </div>
@code {
    protected override void OnInitialized()
    {
        CurrentUserState.OnChange += HandleUserStateChanged;
    }

    private void HandleUserStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUserState.OnChange -= HandleUserStateChanged;
    }
    private void HandleLogoutClick()
    {
        CurrentUserState.ClearUser();
        NavManager.NavigateTo("/login");
    }
}
